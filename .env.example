# Copie para .env.local e preencha.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Somente servidor. Nunca exponha no cliente. (Usado a partir da Fase 1: seed/admin.)
SUPABASE_SECRET_KEY=

# URL pública do app (usada nos links de e-mail de autenticação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic (Fase 3, copiloto). Somente servidor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Esforço do modelo (low | medium | high | xhigh | max) e teto de tokens de saída por passo.
COPILOTO_EFFORT=medium
COPILOTO_MAX_TOKENS=16000

# MapTiler (cloud.maptiler.com → Account → API keys): tiles e geocodificação.
# Pública (vai para o navegador): restrinja a chave aos domínios do app no painel da MapTiler.
# Sem chave, o mapa usa tiles do OpenStreetMap (só para desenvolvimento).
NEXT_PUBLIC_MAPTILER_KEY=sua_chave_maptiler

# Voyage AI (Fase 5): embeddings para RAG da legislação. Somente servidor.
# Sem chave, a busca na legislação é só por palavras.
VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-4

# Ingestão normativa (ADR 0011): modelos de OCR e de extração assistida (opcionais).
# INGESTAO_OCR_MODEL=claude-sonnet-5-5
# INGESTAO_EXTRACAO_MODEL=claude-opus-5-5
